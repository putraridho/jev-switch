#!/usr/bin/env bash
# jev-claude: the normal Claude Code interface with a "Jev Code" model that routes
# each turn (Sonnet, or Opus for hard and security work) through jev-gateway.
# Starts the gateway if it isn't running. Plain `claude` is unaffected.
set -euo pipefail
ADDR="${JEV_GATEWAY_ADDR:-127.0.0.1:18780}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/jev-router"
mkdir -p "$STATE"
# Start on a clean screen, right before handing the terminal to Claude Code. Only on a
# terminal, and never on a dumb one: a piped or dumb run must not get escape codes. This
# is the same sequence jev-code uses for its own clear (home, screen, scrollback).
clear_screen() {
  [ -t 1 ] || return 0
  case "${TERM:-}" in ""|dumb) return 0 ;; esac
  printf '\033[H\033[2J\033[3J'
}
up() { curl -fsS --max-time 1 "http://$ADDR/healthz" >/dev/null 2>&1; }
if ! up; then
  JEV_GATEWAY_ADDR="$ADDR" nohup jev-gateway >>"$STATE/gateway.out" 2>&1 &
  for _ in $(seq 1 30); do up && break; sleep 0.1; done
  up || { echo "jev-claude: jev-gateway didn't start; see $STATE/gateway.out" >&2; exit 1; }
fi
export ANTHROPIC_BASE_URL="http://$ADDR"
export CLAUDE_CODE_GATEWAY_HINT_HEADERS=1
export ANTHROPIC_CUSTOM_MODEL_OPTION="jev-code[1m]"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="Jev Code"
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Routes each turn: Sonnet, or Opus for hard and security work"
# The delegate tool (MCP server `jev`): Claude Code can hand self-contained pieces to workers on
# your other subscriptions (Codex, Antigravity ...), each in its own git worktree, and merge the
# diffs it reviewed. Needs jev-delegate-mcp (installed beside jev-code); JEV_DELEGATE=off skips it.
# The config is per project folder and rewritten each start (the content is the same for every
# session in the folder). `--mcp-config` takes several values, so it is written with `=`: a
# prompt typed after `--mcp-config <file>` would be read as another config file.
mcp=()
DELEGATE="$(command -v jev-delegate-mcp || true)"
if [ "${JEV_DELEGATE:-on}" != off ] && [ -n "$DELEGATE" ]; then
  # Any checksum tool will do; without one the delegate is skipped, not the launch.
  key="$(printf %s "$PWD" | { shasum || sha1sum || cksum; } 2>/dev/null | cut -c1-12 | tr -c 'A-Za-z0-9\n' _ || true)"
fi
if [ -n "${key:-}" ]; then
  cfg="$STATE/mcp-delegate-claude-$key.json"
  json() { local s=${1//\\/\\\\}; printf '"%s"' "${s//\"/\\\"}"; }
  (umask 077; printf '{"mcpServers":{"jev":{"command":%s,"args":["--dir",%s]}}}\n' "$(json "$DELEGATE")" "$(json "$PWD")" >"$cfg")
  mcp=("--mcp-config=$cfg")
fi
for a in "$@"; do
  case "$a" in --model|--model=*) clear_screen; exec claude ${mcp[@]+"${mcp[@]}"} "$@" ;; esac
done
# Orchestrate mode (off by default; /orchestrate on turns it on for a session).
MOD="${XDG_DATA_HOME:-$HOME/.local/share}/jev-router/mods/jev-orchestrate"
plugin=()
[ -d "$MOD" ] && plugin=(--plugin-dir "$MOD")
clear_screen
exec claude ${mcp[@]+"${mcp[@]}"} --model 'jev-code[1m]' ${plugin[@]+"${plugin[@]}"} "$@"
