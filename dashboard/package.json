{
  "name": "flashboard-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh stub",
    "dev:real": "sh scripts/dev.sh real",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node scripts/check-types.ts",
    "lint": "eslint --no-inline-config --max-warnings 0 . && stylelint \"src/**/*.{css,svelte}\" && prettier --check .",
    "test": "vitest run",
    "test:screens": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
