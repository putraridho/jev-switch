# jev-router configuration. Copy this file to ~/.jev-router.env, then protect it:
#
#   cp .jev-router.env.example ~/.jev-router.env && chmod 600 ~/.jev-router.env
#
# One KEY=VALUE per line. Lines starting with # are ignored, quotes are optional.
# A variable set in your shell wins over this file. Set JEV_ROUTER_ENV to use a
# different file. Run `jev-code doctor` to see what is configured and what is missing.
#
# You do NOT need every provider. jev-router uses whatever is installed and logged in
# and skips the rest, so you can start with Claude alone and add the others later.
# Nothing here is needed for a login-based provider (Claude, Codex, Grok, Gemini):
# log in with that tool's own command instead.

# ---------------------------------------------------------------- required
# Jev, the service that judges each request (task type, difficulty, security).
# Its key is required at startup. If the service is unavailable, routing falls
# back to usable models while retaining the local hard security constraints.
JEV_API_KEY=
# Accepted alias; configure one Jev key name, not both.
# TYPESAFE_API_KEY=

# ------------------------------------------------- optional: more providers
# Add a line below only when you start using that provider.

# DeepSeek: pay per token (no subscription). Setting the key is your agreement to
# pay, so it is used only for work the router judges safe for it (never security).
# DEEPSEEK_API_KEY=

# Grok: an API key is optional when using `grok login`.
# API-key authentication is not proof that a turn uses your subscription quota.
# XAI_API_KEY=

# Gemini with an API key (instead of `gemini` or `agy` login).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# For Vertex AI or Google Cloud auth, set one of:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_GENAI_USE_GCA=1

# ------------------------------------------------------- optional: behaviour
# Allow models billed as extra credits (Claude Fable on a Pro plan). On Claude Max
# or Ultra this is automatic, because those plans include Fable.
# JEV_ALLOW_CREDITS=1

# Routing across providers. "off" runs everything on Claude, like the old jev-code.
# JEV_PROVIDERS=off

# Orchestration: a planner model hands pieces of a big task to cheaper workers.
# On by default in interactive sessions, off for one-shot runs. Saved session
# choices take precedence; /orchestrate on|off changes the saved choice.
# JEV_ORCHESTRATE=on

# Auto-merge eligible workers after checks pass. Off requires explicit review/merge.
# This does not turn worker accounting into a shared main/MCP budget ledger.
# JEV_AUTO_MERGE=on

# Compact before a message when reported context occupancy reaches this percent.
# Values: 50..99, or off. Unknown occupancy never triggers auto-compaction.
# JEV_AUTOCOMPACT=90

# Routing-off/gateway tuning; automatic provider routing uses task-specific chains.
# DOWNGRADE_AFTER=2
# CODE_STRONG_THRESHOLD=0.85

# Ring the terminal bell after turns taking at least 15 seconds; off disables it.
# JEV_BELL=on

# Prevent prompts from leaving this machine. The current providers are cloud-based,
# so this can leave no route rather than silently sending the prompt elsewhere.
# JEV_LOCAL_ONLY=0

# Disable the cached provider readiness snapshot and probe again at startup.
# JEV_PROBE_CACHE=off

# Longest wait for Jev before a turn goes ahead on its current model (ms).
# JEV_TIMEOUT_MS=3000

# Stop a turn when the tool prints nothing for this long (seconds).
# CODE_IDLE_TIMEOUT_SECS=900

# Another Jev endpoint (a proxy, or a test server).
# JEV_TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# Where the turn log goes (default: ~/.local/state/jev-router/code-turns.jsonl).
# JEV_CODE_LOG=

# Other JSON-lines log overrides (defaults are in ~/.local/state/jev-router).
# Provider failure messages/raw lines: provider-failures.jsonl.
# JEV_FAILURE_LOG=
# Delegated worker attempts: orchestration.jsonl.
# JEV_DELEGATE_LOG=
# Gateway routing decisions: gateway.jsonl.
# JEV_GATEWAY_LOG=
# Gateway request/response usage: usage.jsonl.
# JEV_USAGE_LOG=
# Gateway aggregated turns: turns.jsonl.
# JEV_TURNS_LOG=
# Gateway orchestration decisions: orch.jsonl.
# JEV_ORCH_LOG=

# What /diff pipes long output through on a terminal (default: less -R).
# PAGER=less -R

# Editor used by /edit and /memory. VISUAL wins over EDITOR.
# EDITOR=vi
# VISUAL=vi

# Checkout used by /update, only if it cannot locate the installed source.
# JEV_SOURCE_DIR=/home/you/src/jev-switch

# The delegate tool orchestration uses, if it is not next to jev-code.
# JEV_DELEGATE_BIN=

# A JSON file that replaces the model order for some task types. Example content:
#   { "hard_debug": ["codex:gpt-6.1-sol", "claude:claude-opus-5-5"] }
# JEV_CHAINS=/home/you/.config/jev-router/chains.json

# ------------------------------------------------ optional: tool permissions
# Claude Code permission mode for jev-code turns (default acceptEdits: edits are
# applied without asking, so use jev-code inside a git repository).
# CODE_PERMISSION_MODE=acceptEdits
# Extra tools Claude may use without asking, e.g. "Bash(cargo test) Bash(git status)".
# CODE_ALLOWED_TOOLS=
# Codex sandbox: read-only or workspace-write (the default). Anything else is ignored.
# CODEX_SANDBOX=workspace-write
# Let Codex commands use the network and open local ports (vitest, dev servers, gh, git push).
# The workspace-write sandbox still confines file writes. Off by default.
# CODEX_NETWORK=off

# Paths, only if a tool is not on your PATH.
# CLAUDE_BIN=
# CODEX_BIN=
# GROK_BIN=
# GEMINI_BIN=
# AGY_BIN=

# ---------------------------------------- reference: shell-only UI settings
# These readers use the process environment, not ~/.jev-router.env. Copy an
# export command to your shell; uncommenting it in this file alone has no effect.
# JEV_ROUTER_ENV itself must also be exported before startup to select another file.
# export JEV_ROUTER_ENV="$HOME/.jev-router.env"
# export JEV_PROFILE=work
# export JEV_THEME=dark
# export NO_COLOR=1
# export JEV_REDUCED_MOTION=1
# export REDUCE_MOTION=1
# export JEV_VIM=1
# export JEV_INLINE=1
# export JEV_CLASSIC_UI=1
# export JEV_SHOW_THINKING=1
# export JEV_SHOW_NARRATION=1
# export JEV_CODE_GUTTER=1
# export JEV_TOOL_ROWS=all
# export JEV_KEYBINDINGS="$HOME/.config/jev-router/keybindings"
# Log rotation in MB: default 50; 0 disables rotation.
# export JEV_LOG_MAX_MB=50
# Export tool-home overrides so both the CLI and its telemetry reader see them.
# export CODEX_HOME="$HOME/.codex"
# XDG directory overrides also need to be exported.
# export XDG_CONFIG_HOME="$HOME/.config"
# export XDG_DATA_HOME="$HOME/.local/share"
# export XDG_STATE_HOME="$HOME/.local/state"

# ------------------------------------- reference: shell-only gateway settings
# For jev-claude/jev-gateway, export these before starting the gateway. An already
# running gateway keeps its startup settings. JEV_ORCH is distinct from jev-code's
# JEV_ORCHESTRATE; the Claude mod starts off unless JEV_ORCH_DEFAULT is on.
# export JEV_GATEWAY_ADDR=127.0.0.1:18780
# Only 1 permits a non-loopback bind; keep this off unless exposure is intentional.
# export JEV_GATEWAY_ALLOW_REMOTE=0
# export JEV_GATEWAY_MAX_INFLIGHT=32
# export JEV_GATEWAY_UPSTREAM=https://api.anthropic.com
# export JEV_DELEGATE=on
# export JEV_ORCH=on
# export JEV_ORCH_DEFAULT=off
# export ORCH_TRIGGER_P=0.70
# export ORCH_PLANNER=claude-opus-5-5
# export ORCH_REQUIRE_OPUS=on
# export JEV_FABLE=on
# export FABLE_THRESHOLD=0.90
# Optional worker simple-task confidence override; unset uses the built-in policy.
# export WORKER_CHEAP_P=0.90
# Optional extra correction judgment; off by default.
# export JEV_CORRECTION_CHECK=0
# Shared with routing-off jev-code, but the gateway requires shell exports.
# export DOWNGRADE_AFTER=2
# export CODE_STRONG_THRESHOLD=0.85

# -------------------------------------- reference: shell-only evaluation tools
# `chat` uses Claude Code login, not an ANTHROPIC_API_KEY from this file.
# Confidence defaults vary by command; calibrate before changing them.
# export CHEAP_THRESHOLD=0.50
# export STRONG_THRESHOLD=0.85
# export MISS_BUDGET=0.05
# `ask` silent-turn timeout in seconds (separate from jev-code's idle timeout).
# export ASK_IDLE_SECS=600
# `route` dry-run controls; these do not change live provider entitlements.
# export ROUTE_MODE=code
# export ROUTE_SIGNALS=1
# export ROUTE_JSON=1
# export ROUTE_CREDITS=1
# export ROUTE_CODEX_MODELS=gpt-6.1-sol,gpt-6.1-terra,gpt-6-luna
